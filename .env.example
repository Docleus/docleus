# Copy to .env next to compose.yaml and fill in. Never commit .env.
DOCLEUS_IMAGE=ghcr.io/docleus/docleus:0.0.10
DOCLEUS_PORT=3000
# The URL people open; set with a reverse proxy, together with DOCLEUS_TRUST_PROXY=true.
DOCLEUS_PUBLIC_URL=
DOCLEUS_TRUST_PROXY=

POSTGRES_PASSWORD=change-me
# POSTGRES_IMAGE=postgres:17-alpine@sha256:3540c0362c809df084ffac0ae69fe794515f9de92692f02178bcdce0ef0302ac

# S3-compatible storage (compose.yaml). The bundled server uses these as its root credentials.
S3_ACCESS_KEY=docleus
S3_SECRET_KEY=change-me-too
# At least 32 characters; keeps signed blob URLs valid across restarts and instances.
S3_SIGNING_SECRET=
S3_BUCKET=docleus
# S3_ENDPOINT=http://s3:9000
# S3_REGION=us-east-1
# S3_IMAGE=rustfs/rustfs:1.0.4@sha256:ed9210d6411d77ffceb70d94b964a3cb7d225983368bc25bebe01e995293dcc2

# Local blobs (compose.small.yaml): at least 32 characters, shared by every
# web and worker process. Empty: generated once into /data/blob-secret.
DOCLEUS_BLOB_SECRET=

# Invitation emails.
DOCLEUS_SMTP_URL=
DOCLEUS_SMTP_FROM=

# OpenID Connect sign-in; enables plugin-auth-oidc when set, applied on every boot.
DOCLEUS_OIDC_ISSUER=
DOCLEUS_OIDC_CLIENT_ID=
DOCLEUS_OIDC_CLIENT_SECRET=
DOCLEUS_OIDC_LABEL=
